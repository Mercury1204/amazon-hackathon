# Large challenge data — never commit (>100 MB files, not redistributable)
DATA/**/*.tsv
DATA/**/*.zip
DATA/__MACOSX/

# OS junk
**/.DS_Store

# Secrets and credentials — never commit (RULES.md §5.2, §6.6)
kaggle.json
*.kaggle.json
credentials.json
.kaggle/
.netrc
netrc
.env
.env.*
*.pem
*.key

# Python / environment
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated caches and artifacts
tools/eda_cache/
graphify-out/cache/
graphify-out/.graphify_*
output/**/*.tsv

# Pipeline intermediates (parquet/json; regenerate with ber.cli)
DATA/keys/
DATA/candidates/
DATA/processed/
DATA/reports/
DATA/tmp/
DATA/pairs/
DATA/features/

# Submission build output
dist/

# Kaggle upload staging (builds a ~950 MB zip of non-redistributable data)
DATA/kaggle_upload/
